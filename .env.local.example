# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Server-only. Never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Salt for the SHA-256 of caller IPs in `ai_usage`. Set this in production;
# without it the hashes use a known fallback and are guessable.
IP_HASH_SALT=change-me

# ── Supabase service role ─────────────────────────────────────────────────────
# Server-only, bypasses RLS. Used for exactly one thing: reading the blurred
# face variants out of the private bucket after the route has decided which
# blur level the conversation has earned. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
